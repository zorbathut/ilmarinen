<Project>
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildThisFileDirectory).git/HEAD;$(MSBuildThisFileDirectory).git/refs/heads/**"
          Outputs="$(IntermediateOutputPath)BuildInfo.g.cs">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMsBuild="true" StandardOutputImportance="low"
          Condition="'$(GitCommit)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="printf 'namespace Ilmarinen;\ninternal static class BuildInfo\n{\n    public const string GitCommit = &quot;$(GitCommit)&quot;;\n}\n' > $(IntermediateOutputPath)BuildInfo.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>
