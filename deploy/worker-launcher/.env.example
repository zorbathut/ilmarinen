# Copy this file to .env and fill in your real values.
# .env is gitignored and will not be committed.

# SignalR hub URL — the server's WORKER port (8081 by default), not the public port.
# The server has to publish that port on an address this host can reach. deploy/server-docker/ binds
# it to loopback by default, so read its README before pointing a remote worker at it.
#
# Worker on the SAME host as deploy/server-docker/? Use the service name together with the same-host
# overlay (docker-compose.same-host.yml) — then the server publishes nothing at all:
#   ILMARINEN_SERVER_URL=http://server:8081
ILMARINEN_SERVER_URL=http://ilmarinen-server.example.com:8081

# Worker key from server registration (via the server UI or POST /api/workers).
# Format: {name}:{guid}:{workerPrivBase64}:{serverPubBase64}
ILMARINEN_WORKER_KEY=REPLACE_WITH_WORKER_KEY
