# Copy this file to .env and fill in your real values.
# .env is gitignored and will not be committed.

# Server identity and credential-encryption key. Generate with:
#   openssl rand -base64 32
# BACK THIS UP alongside the database. It decrypts stored Git credentials, and its public half is
# baked into every worker key you issue — losing it or rotating it is not a routine operation.
ILMARINEN_SERVER_KEY=REPLACE_WITH_GENERATED_KEY

# PostgreSQL password. Generate with:
#   openssl rand -hex 32
# Only takes effect on the first boot, while the database volume is still empty. Changing it later
# locks the server out of its own database — see README.md.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Addresses the server's two ports bind to. Both default to 127.0.0.1, because the public API is
# UNAUTHENTICATED and parts of the worker hub are too.
#
# A worker on THIS host needs neither of these widened — it joins the server's Compose network and
# reaches it as `server:8081` (see ../worker-docker/docker-compose.same-host.yml).
#
# A REMOTE worker needs WORKER_BIND_ADDR set to an address it can reach. Use a private-network
# address (VPN/Tailscale/WireGuard), not a public interface.
#BIND_ADDR=127.0.0.1
#WORKER_BIND_ADDR=100.64.0.1
