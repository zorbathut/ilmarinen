# Ilmarinen worker secrets
# Copy this file to ilmarinen-secrets.nix and fill in your actual values.
# DO NOT commit ilmarinen-secrets.nix to source control!

{
  # SignalR hub URL (worker port, e.g. 8081)
  serverUrl = "http://ilmarinen-server:8081";

  # Worker key from server registration (POST /api/workers)
  # Format: {name}:{guid}:{workerPrivBase64}:{serverPubBase64}
  workerKey = "REPLACE_WITH_WORKER_KEY";
}
