# Copy this file to .env and fill in your real values.
# .env is gitignored and will not be committed.

# SignalR hub URL — the server's WORKER port (8081 by default), not the public port.
# The server must actually publish this port; the stock docker-compose.yml does not. See README.md.
ILMARINEN_SERVER_URL=http://ilmarinen-server.example.com:8081

# Worker key from server registration (via the server UI or POST /api/workers).
# Format: {name}:{ulid}:{workerPrivBase64}:{serverPubBase64}
ILMARINEN_WORKER_KEY=REPLACE_WITH_WORKER_KEY
