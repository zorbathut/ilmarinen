<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ilmarinen-worker-launcher</AssemblyName>
    <RootNamespace>Ilmarinen.WorkerLauncher</RootNamespace>
  </PropertyGroup>

  <!-- Deliberately no project or package references: the launcher is the one component that cannot auto-update, so its only dependencies are the BCL and the frozen manifest contract. -->

</Project>
