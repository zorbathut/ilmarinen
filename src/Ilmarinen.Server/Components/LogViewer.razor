@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@implements IDisposable
@inject LogSubscriptionService SubscriptionService
@inject JobLogRepository LogRepository

<div class="log-viewer">
    <div class="log-toolbar">
        <label class="log-option">
            <input type="checkbox" @bind="autoScroll" /> Auto-scroll
        </label>
        <label class="log-option">
            <input type="checkbox" @bind="showStderr" /> Show stderr
        </label>
        <span class="log-stats">@logLines.Count lines | @FormatBytes(totalBytes)</span>
        @if (IsTruncated)
        {
            <span class="log-truncated" title="This view holds the first @ChunkLimit chunks of the log and renders the last @RenderLimit lines of those">truncated</span>
        }
        <a href="/jobs/@JobId/logs" class="btn-download">Full screen</a>
        @* The download attribute stops Blazor from intercepting the click: otherwise the router takes the /api path first, matches no page, and only then force-loads it — a needless round trip through the circuit, and one that needs the circuit to be alive. *@
        <a href="/api/jobs/@JobId/logs/download" class="btn-download" download>Download</a>
        @if (IsStreaming)
        {
            <span class="log-status streaming">Streaming...</span>
        }
        else if (isComplete)
        {
            <span class="log-status complete">Complete</span>
        }
    </div>

    <div class="log-container" @ref="logContainer">
        @if (logLines.Count == 0 && !IsStreaming)
        {
            <div class="log-empty">No logs available</div>
        }
        else
        {
            @foreach (var line in GetVisibleLines())
            {
                <div class="log-line @(line.IsMetadata ? "log-meta" : line.IsStderr ? "log-stderr" : "log-stdout")">@line.Content</div>
            }
        }
    </div>
</div>

<style>
    .log-viewer {
        display: flex;
        flex-direction: column;
    }
    .log-viewer .log-toolbar {
        border-radius: 0.5rem 0.5rem 0 0;
    }
    .log-truncated {
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        background-color: #78350f;
        color: #fbbf24;
    }
    .log-container {
        border-radius: 0 0 0.5rem 0.5rem;
        min-height: 200px;
        max-height: 600px;
    }
    .log-empty {
        color: var(--text-secondary);
        font-style: italic;
    }
</style>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    [Parameter]
    public bool IsStreaming { get; set; }

    // Past these the inline view would cost more than a job page should; the full-screen viewer is the way to read a log this long.
    private const int ChunkLimit = 1000;
    private const int RenderLimit = 2000;

    private bool IsTruncated
    {
        get { return loadWasTruncated || logLines.Count > RenderLimit; }
    }

    private string? subscriberId;
    private bool loadWasTruncated;
    private List<LogLine> logLines = new();
    private ElementReference logContainer;
    private bool autoScroll = true;
    private bool showStderr = true;
    private bool isComplete;
    private long totalBytes;
    private int lastSequence;

    protected override async Task OnInitializedAsync()
    {
        // Load historical logs first
        await LoadHistoricalLogsAsync();

        // Subscribe to live updates
        subscriberId = SubscriptionService.Subscribe(
            JobId,
            OnLogChunk,
            OnJobCompleted);
    }

    private async Task LoadHistoricalLogsAsync()
    {
        var chunks = await LogRepository.GetChunksAsync(JobId, 0, ChunkLimit);
        loadWasTruncated = chunks.Count == ChunkLimit;

        foreach (var chunk in chunks)
        {
            if (chunk.SequenceNumber > lastSequence)
            {
                lastSequence = chunk.SequenceNumber;
                ParseAndAddContent(chunk.Content);
            }
        }
    }

    private void OnLogChunk(LogBroadcast chunk)
    {
        if (chunk.SequenceNumber <= lastSequence) return;
        lastSequence = chunk.SequenceNumber;

        ParseAndAddContent(chunk.Content);
        InvokeAsync(StateHasChanged);
    }

    private void ParseAndAddContent(string content)
    {
        foreach (var entry in LogChunkParser.ParseEntries(content))
        {
            totalBytes += entry.Data.Length;

            // Split by newlines to create individual log lines
            foreach (var logLine in entry.Data.Split('\n'))
            {
                if (!string.IsNullOrEmpty(logLine))
                {
                    logLines.Add(new LogLine
                    {
                        Content = logLine,
                        IsStderr = entry.Type == "e",
                        IsMetadata = entry.Type == "m"
                    });
                }
            }
        }
    }

    private void OnJobCompleted(JobStatus status)
    {
        isComplete = true;
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<LogLine> GetVisibleLines()
    {
        var lines = showStderr ? logLines : logLines.Where(l => !l.IsStderr);
        // Return last 2000 lines to prevent UI slowdown
        return lines.TakeLast(RenderLimit);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    public void Dispose()
    {
        if (subscriberId != null)
        {
            SubscriptionService.Unsubscribe(JobId, subscriberId);
        }
    }

    private record LogLine
    {
        public required string Content { get; init; }
        public required bool IsStderr { get; init; }
        public bool IsMetadata { get; init; }
    }
}
