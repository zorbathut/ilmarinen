@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<LogViewer> Logger

@* Everything inside this div is built and owned by log-viewer.js — Blazor holds no part of the log, which is the point. The render tree has to stay a single childless element: anything rendered in here, a spinner or an error banner, gives Blazor's diff a reason to start editing DOM that JS owns. *@
<div class="log-shell @Class" @ref="container"></div>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    /// <summary>What the page knew when it rendered. Read once, at attach: the viewer tracks the job's status from the feed and the live stream from then on, so later values here are ignored.</summary>
    [Parameter]
    public JobStatus InitialStatus { get; set; }

    [Parameter]
    public string Class { get; set; } = "";

    private ElementReference container;
    private IJSObjectReference? module;
    private Guid attachedJobId;
    private int handle;
    private bool disposed;

    /// <summary>
    /// A viewer attaches once and never re-targets, so a caller that reuses one across jobs would be
    /// shown the wrong log with nothing to indicate it. Giving it <c>@key="job.Id"</c> makes a job
    /// change build a new component, which is what both call sites do.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (attachedJobId != Guid.Empty && attachedJobId != JobId)
        {
            throw new InvalidOperationException($"LogViewer is showing job {attachedJobId} and cannot be re-pointed at {JobId}. Give it @key=\"job.Id\" so a job change builds a new component.");
        }
    }

    /// <summary>
    /// Attaches on the component's own first render and never again: re-attaching in place would
    /// race, since <see cref="module"/> is only assigned after the import round-trip and a second
    /// attach could start before the first finished.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var loaded = await JS.InvokeAsync<IJSObjectReference>("import", "./log-viewer.js");
            var attached = await loaded.InvokeAsync<int>("attach", container, JobId, InitialStatus.ToString());

            // Disposal can land while the import is in flight, and it cannot detach a viewer it has no handle for yet — leaving its poll timer and log stream running for the life of the tab.
            if (disposed)
            {
                await loaded.InvokeVoidAsync("detach", attached);
                await loaded.DisposeAsync();
                return;
            }

            module = loaded;
            handle = attached;
            attachedJobId = JobId;
        }
        catch (Exception ex) when (IsCircuitGone(ex))
        {
            Logger.LogDebug(ex, "Circuit went away while attaching the log viewer for job {JobId}", JobId);
        }
    }

    /// <summary>
    /// Navigating away is a route change, not a page load, so without this the viewer's poll timer,
    /// log stream and scroll listener would outlive the page that owns them.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        disposed = true;

        if (module == null)
        {
            return;
        }

        var leaving = module;
        module = null;

        try
        {
            await leaving.InvokeVoidAsync("detach", handle);
            await leaving.DisposeAsync();
        }
        catch (Exception ex) when (IsCircuitGone(ex))
        {
            // The circuit can go first, in which case the browser has dropped the page and its timers along with it.
            Logger.LogDebug(ex, "Log viewer for job {JobId} was already gone at teardown", JobId);
        }
    }

    private static bool IsCircuitGone(Exception ex)
    {
        return ex is JSDisconnectedException or ObjectDisposedException or TaskCanceledException;
    }
}
