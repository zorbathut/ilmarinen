
@if (WorkerId != null)
{
    <a href="/workers/@WorkerId">@DisplayName</a>
}
else
{
    <span>-</span>
}

@code {
    [Parameter]
    public Guid? WorkerId { get; set; }

    [Parameter]
    public string? WorkerName { get; set; }

    private string DisplayName =>
        !string.IsNullOrEmpty(WorkerName) ? WorkerName : WorkerId?.ToString()[..8] ?? "-";
}
