
@if (WorkerId != null)
{
    <a href="/workers/@WorkerId">@DisplayName</a>
}
else
{
    <span>-</span>
}

@code {
    [Parameter]
    public Guid? WorkerId { get; set; }

    [Parameter]
    public string? WorkerName { get; set; }

    private string DisplayName
    {
        get
        {
            if (!string.IsNullOrEmpty(WorkerName))
            {
                return WorkerName;
            }
            return ShortId.From(WorkerId!.Value);
        }
    }
}
