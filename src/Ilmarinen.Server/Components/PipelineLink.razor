
@if (PipelineId != null)
{
    <a href="/pipelines/@PipelineId">@DisplayName</a>
}
else
{
    <span>-</span>
}

@code {
    [Parameter]
    public Guid? PipelineId { get; set; }

    [Parameter]
    public string? PipelineName { get; set; }

    private string DisplayName
    {
        get
        {
            if (!string.IsNullOrEmpty(PipelineName))
            {
                return PipelineName;
            }
            return ShortId.From(PipelineId!.Value);
        }
    }
}
