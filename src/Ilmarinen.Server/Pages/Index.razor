@page "/"
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Index> Logger
@inject UIEventService UIEvents

<h1 class="page-title">Dashboard</h1>

@if (stats != null)
{
    <div class="stats-grid">
        <div class="card">
            <div class="card-title">Total Jobs</div>
            <div class="card-value">@stats.TotalJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Running</div>
            <div class="card-value" style="color: var(--badge-running-fg);">@stats.RunningJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Queued</div>
            <div class="card-value" style="color: var(--badge-queued-fg);">@stats.QueuedJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Successful</div>
            <div class="card-value" style="color: var(--badge-success-fg);">@stats.SuccessfulJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Failed</div>
            <div class="card-value" style="color: var(--badge-failed-fg);">@stats.FailedJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Workers</div>
            <div class="card-value">@stats.ConnectedWorkers / @stats.TotalWorkers</div>
        </div>
        <div class="card">
            <div class="card-title">Pipelines</div>
            <div class="card-value">@stats.TotalPipelines</div>
        </div>
    </div>
}

<div class="card">
    <h2 class="card-title" style="font-size: 1.25rem; margin-bottom: 1rem;">Recent Jobs</h2>
    <JobTable Items="recentJobs" StorageKey="dashboard-jobs" Defaults="JobColumns" />
</div>

@code {
    private DashboardStats? stats;
    private IReadOnlyList<JobInfo>? recentJobs;
    private static readonly IReadOnlyList<string> JobColumns = ["id", "status", "repository", "ref", "script", "created", "worker"];

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        UIEvents.OnJobsChanged += OnChanged;
        UIEvents.OnWorkersChanged += OnChanged;
    }

    private async void OnChanged()
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException ex)
        {
            Logger.LogDebug(ex, "Dashboard page went away mid-refresh");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing the dashboard page failed");
        }
    }

    private async Task RefreshAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var dashboard = scope.ServiceProvider.GetRequiredService<DashboardService>();
        stats = await dashboard.GetStatsAsync();
        recentJobs = await scope.ServiceProvider.GetRequiredService<JobRepository>().GetRecentAsync(10);
    }

    public void Dispose()
    {
        UIEvents.OnJobsChanged -= OnChanged;
        UIEvents.OnWorkersChanged -= OnChanged;
    }
}
