@page "/"
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject UIEventService UIEvents

<h1 class="page-title">Dashboard</h1>

@if (stats != null)
{
    <div class="stats-grid">
        <div class="card">
            <div class="card-title">Total Jobs</div>
            <div class="card-value">@stats.TotalJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Running</div>
            <div class="card-value" style="color: var(--badge-running-fg);">@stats.RunningJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Queued</div>
            <div class="card-value" style="color: var(--badge-queued-fg);">@stats.QueuedJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Successful</div>
            <div class="card-value" style="color: var(--badge-success-fg);">@stats.SuccessfulJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Failed</div>
            <div class="card-value" style="color: var(--badge-failed-fg);">@stats.FailedJobs</div>
        </div>
        <div class="card">
            <div class="card-title">Workers</div>
            <div class="card-value">@stats.ConnectedWorkers / @stats.TotalWorkers</div>
        </div>
        <div class="card">
            <div class="card-title">Pipelines</div>
            <div class="card-value">@stats.TotalPipelines</div>
        </div>
    </div>
}

<div class="card">
    <h2 class="card-title" style="font-size: 1.25rem; margin-bottom: 1rem;">Recent Jobs</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Repository</th>
                <th>Ref</th>
                <th>Script</th>
                <th>Created</th>
                <th>Worker</th>
            </tr>
        </thead>
        <tbody>
            @if (recentJobs != null)
            {
                @foreach (var job in recentJobs)
                {
                    <tr>
                        <td><a href="/jobs/@job.Id">@job.Id.ToString()[..8]</a></td>
                        <td><span class="status-badge status-@job.Status.ToString().ToLower()">@job.Status</span></td>
                        <td>@GetShortRepoUrl(job.RepoUrl)</td>
                        <td>@job.Ref</td>
                        <td>@job.ScriptPath</td>
                        <td>@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><WorkerLink WorkerId="job.WorkerId" WorkerName="@job.WorkerName" /></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private DashboardStats? stats;
    private IReadOnlyList<RecentJob>? recentJobs;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        UIEvents.OnJobsChanged += OnChanged;
        UIEvents.OnWorkersChanged += OnChanged;
    }

    private async void OnChanged()
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task RefreshAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var dashboard = scope.ServiceProvider.GetRequiredService<DashboardService>();
        stats = await dashboard.GetStatsAsync();
        recentJobs = await dashboard.GetRecentJobsAsync();
    }

    public void Dispose()
    {
        UIEvents.OnJobsChanged -= OnChanged;
        UIEvents.OnWorkersChanged -= OnChanged;
    }

    private string GetShortRepoUrl(string url)
    {
        if (url.StartsWith("https://github.com/"))
            return url.Replace("https://github.com/", "");
        if (url.StartsWith("git@github.com:"))
            return url.Replace("git@github.com:", "").Replace(".git", "");
        return url;
    }
}
