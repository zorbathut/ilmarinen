@page "/"
@namespace Ilmarinen.Server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ilmarinen</title>
    <base href="~/" />
    <style>
        :root {
            --bg-primary: #f5f5f5;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e0e0e0;
            --text-primary: #1a1a1a;
            --text-secondary: #666666;
            --accent: #c9304a;
            --success: #16a34a;
            --warning: #ca8a04;
            --error: #dc2626;
            --log-bg: #f0f0f0;
            --badge-pending-bg: #e5e7eb; --badge-pending-fg: #6b7280;
            --badge-queued-bg: #dbeafe; --badge-queued-fg: #2563eb;
            --badge-running-bg: #cffafe; --badge-running-fg: #0891b2;
            --badge-success-bg: #dcfce7; --badge-success-fg: #16a34a;
            --badge-failed-bg: #fee2e2; --badge-failed-fg: #dc2626;
            --badge-cancelled-bg: #fef3c7; --badge-cancelled-fg: #ca8a04;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #1a1a2e;
                --bg-secondary: #16213e;
                --bg-tertiary: #0f3460;
                --text-primary: #e6e6e6;
                --text-secondary: #a0a0a0;
                --accent: #e94560;
                --success: #4ade80;
                --warning: #fbbf24;
                --error: #ef4444;
                --log-bg: #0d0d0d;
                --badge-pending-bg: #374151; --badge-pending-fg: #9ca3af;
                --badge-queued-bg: #1e3a5f; --badge-queued-fg: #60a5fa;
                --badge-running-bg: #164e63; --badge-running-fg: #22d3ee;
                --badge-success-bg: #14532d; --badge-success-fg: #4ade80;
                --badge-failed-bg: #450a0a; --badge-failed-fg: #f87171;
                --badge-cancelled-bg: #422006; --badge-cancelled-fg: #fbbf24;
            }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            min-height: 100dvh;
        }
        .layout {
            display: flex;
            min-height: 100vh;
            min-height: 100dvh;
        }
        .sidebar {
            width: 220px;
            background-color: var(--bg-secondary);
            padding: 1rem;
            border-right: 1px solid var(--bg-tertiary);
        }
        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .sidebar h1 {
            font-size: 1.25rem;
            color: var(--accent);
        }
        .nav-toggle {
            display: none;
            background: none;
            border: 1px solid var(--bg-tertiary);
            border-radius: 0.25rem;
            color: var(--text-primary);
            font-size: 1.25rem;
            padding: 0.25rem 0.6rem;
            cursor: pointer;
        }
        .sidebar nav a {
            display: block;
            padding: 0.75rem 1rem;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
        }
        .sidebar nav a:hover {
            background-color: var(--bg-tertiary);
            color: var(--text-primary);
        }
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 2rem;
            overflow-x: auto;
        }
        .page-title {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-primary);
            overflow-wrap: anywhere;
        }
        input[type="text"], input[type="password"], select {
            font-size: 1rem;
            padding: 0.5rem;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            border: 1px solid var(--bg-tertiary);
            border-radius: 0.25rem;
            max-width: 100%;
            min-width: 0;
        }
        .form-grid input, .form-grid select, .form-row input, .form-row select { width: 100%; }
        .table-scroll { overflow-x: auto; }
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        .form-row {
            display: flex;
            gap: 0.75rem;
            align-items: flex-end;
            flex-wrap: wrap;
        }
        .input-row {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        .input-row input { flex: 1; }
        .card-split {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }
        .card-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .error-message {
            color: var(--error);
            margin-bottom: 0.75rem;
        }
        .card {
            background-color: var(--bg-secondary);
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        .card-title {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }
        .card-value {
            font-size: 2rem;
            font-weight: bold;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 0.75rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--bg-tertiary);
        }
        th {
            color: var(--text-secondary);
            font-weight: 500;
            font-size: 0.875rem;
        }
        td { font-size: 0.875rem; }
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 500;
        }
        .status-pending { background-color: var(--badge-pending-bg); color: var(--badge-pending-fg); }
        .status-queued { background-color: var(--badge-queued-bg); color: var(--badge-queued-fg); }
        .status-running { background-color: var(--badge-running-bg); color: var(--badge-running-fg); }
        .status-success { background-color: var(--badge-success-bg); color: var(--badge-success-fg); }
        .status-failed { background-color: var(--badge-failed-bg); color: var(--badge-failed-fg); }
        .status-cancelled { background-color: var(--badge-cancelled-bg); color: var(--badge-cancelled-fg); }
        .connection-badge {
            display: inline-block;
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            margin-right: 0.5rem;
        }
        .connected { background-color: var(--success); }
        .disconnected { background-color: var(--error); }
        .unhealthy { background-color: var(--badge-failed-bg); }
        .degraded { background-color: var(--warning); }
        .diagnostic-status-healthy { color: var(--success); font-weight: 500; }
        .diagnostic-status-unhealthy { color: var(--error); font-weight: 500; }
        .diagnostic-status-degraded { color: var(--warning); font-weight: 500; }
        .diagnostic-status-running { color: var(--accent); font-weight: 500; }
        .diagnostic-status-unknown { color: var(--text-secondary); }
        .diagnostic-step-table { width: 100%; margin-top: 0.5rem; }
        .diagnostic-step-table td { padding: 0.25rem 0.5rem; vertical-align: top; }
        .diagnostic-step-ok { color: var(--success); font-weight: 500; }
        .diagnostic-step-fail { color: var(--error); font-weight: 500; }
        .diagnostic-step-advisory { color: var(--text-secondary); font-weight: 500; }
        .diagnostic-step-message { font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem; }
        .diagnostic-step-suggestion { font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem; font-style: italic; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; }
        .log-container {
            background-color: var(--log-bg);
            border-radius: 0.5rem;
            padding: 1rem;
            font-family: monospace;
            font-size: 0.875rem;
            max-height: 500px;
            overflow-y: auto;
        }
        .log-line, .log-block {
            white-space: pre-wrap;
            word-break: break-all;
        }
        /* Shared by the inline viewer and the full-screen one, whose toolbar is built by log-viewer.js. */
        .log-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            row-gap: 0.25rem;
            align-items: center;
            padding: 0.5rem 1rem;
            background-color: var(--bg-tertiary);
            font-size: 0.875rem;
        }
        .log-option {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            cursor: pointer;
            color: var(--text-secondary);
        }
        .log-option input {
            cursor: pointer;
        }
        .log-stats {
            margin-left: auto;
            color: var(--text-secondary);
        }
        .log-status {
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
        }
        .log-status.streaming {
            background-color: #164e63;
            color: #22d3ee;
            animation: pulse 2s infinite;
        }
        .log-status.complete {
            background-color: #14532d;
            color: #4ade80;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .log-meta {
            color: #22d3ee;
        }
        .log-toolbar .btn-download, .log-tail-button {
            background-color: var(--bg-secondary);
            border: 1px solid var(--text-secondary);
            color: var(--text-primary);
            border-radius: 0.25rem;
            padding: 0.25rem 0.75rem;
            font-size: 0.75rem;
            text-decoration: none;
            cursor: pointer;
        }
        /* The full-screen viewer at /jobs/{id}/logs, whose DOM is built by log-viewer.js. */
        .logfull-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1rem;
            background-color: var(--bg-secondary);
            border-bottom: 1px solid var(--bg-tertiary);
        }
        .logfull-title {
            margin-right: auto;
            min-width: 0;
            overflow-wrap: anywhere;
            color: var(--text-secondary);
        }
        .logfull {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
            min-width: 0;
        }
        .logfull-pane {
            flex: 1;
            min-height: 0;
            min-width: 0;
            overflow: auto;
            padding: 0.5rem 1rem;
            background-color: var(--log-bg);
            font-family: monospace;
            font-size: 0.875rem;
        }
        .log-block {
            white-space: pre-wrap;
            word-break: break-all;
        }
        .hide-stderr .log-stderr {
            display: none;
        }
        .log-error {
            color: var(--error);
            font-style: italic;
            padding-top: 0.5rem;
        }
        .log-stdout { color: var(--text-primary); }
        .log-stderr { color: var(--error); }
        .detail-grid {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 0.5rem;
        }
        .detail-label {
            color: var(--text-secondary);
            font-size: 0.875rem;
        }
        .detail-value {
            font-size: 0.875rem;
            overflow-wrap: anywhere;
        }
        .btn {
            display: inline-block;
            padding: 0.5rem 1rem;
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 0.25rem;
            cursor: pointer;
            font-size: 0.875rem;
        }
        .btn:hover { opacity: 0.9; }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-danger { background-color: var(--error); }
        .btn-retry {
            padding: 0.15rem 0.5rem;
            font-size: 0.75rem;
            margin-left: 0.5rem;
            vertical-align: middle;
        }
        .btn-download {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: var(--bg-tertiary);
            color: var(--text-primary);
            border-radius: 0.25rem;
            font-size: 0.75rem;
            text-decoration: none;
        }
        .btn-download:hover {
            background-color: var(--accent);
            text-decoration: none;
        }
        .workspace-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.2rem 0.5rem;
            background-color: var(--bg-tertiary);
            border-radius: 0.25rem;
            font-size: 0.75rem;
            margin: 0.125rem;
        }
        .workspace-delete {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.7rem;
            padding: 0 0.2rem;
            line-height: 1;
            border-radius: 0.125rem;
        }
        .workspace-delete:hover { color: var(--error); }
        .workspace-delete:disabled { opacity: 0.3; cursor: not-allowed; }
        @@media (max-width: 768px) {
            .layout { flex-direction: column; }
            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--bg-tertiary);
                padding: 0.5rem 1rem;
            }
            .sidebar-header { margin-bottom: 0; }
            .nav-toggle { display: block; }
            .sidebar nav { display: none; padding-top: 0.5rem; }
            .sidebar.nav-open nav { display: block; }
            .main-content { padding: 1rem; }
            .hide-mobile { display: none; }
            .detail-grid { grid-template-columns: 1fr; gap: 0.125rem; }
            .detail-label { margin-top: 0.625rem; }
            .detail-grid > .detail-label:first-child { margin-top: 0; }
            .form-grid { grid-template-columns: 1fr; }
            .detail-grid input, .detail-grid select { width: 100%; }
            .card-split { flex-direction: column; }
            .card-actions { flex-direction: row; flex-wrap: wrap; }
            th, td { padding: 0.5rem 0.6rem; }
        }
        @@media (pointer: coarse) {
            .btn, .btn-download, .log-toolbar .btn-download, .log-tail-button, .nav-toggle {
                display: inline-flex;
                align-items: center;
                min-height: 44px;
                padding: 0.6rem 1rem;
            }
            .btn-retry { padding: 0.5rem 0.75rem; font-size: 0.8rem; }
            .workspace-delete { font-size: 0.875rem; padding: 0.4rem 0.6rem; }
            .log-option { padding: 0.5rem 0.25rem; }
            .sidebar nav a { padding: 0.85rem 1rem; }
            .logfull-header > a { display: inline-flex; align-items: center; min-height: 44px; }
        }
    </style>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <script src="_framework/blazor.server.js"></script>
    <script>
        window.getBrowserTimeZone = () => Intl.DateTimeFormat().resolvedOptions().timeZone;
    </script>
</body>
</html>
