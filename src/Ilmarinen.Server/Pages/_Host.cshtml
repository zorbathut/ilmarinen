@page "/"
@namespace Ilmarinen.Server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ilmarinen</title>
    <base href="~/" />
    <style>
        :root {
            --bg-primary: #f5f5f5;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e0e0e0;
            --text-primary: #1a1a1a;
            --text-secondary: #666666;
            --accent: #c9304a;
            --success: #16a34a;
            --warning: #ca8a04;
            --error: #dc2626;
            --log-bg: #f0f0f0;
            --badge-pending-bg: #e5e7eb; --badge-pending-fg: #6b7280;
            --badge-queued-bg: #dbeafe; --badge-queued-fg: #2563eb;
            --badge-running-bg: #cffafe; --badge-running-fg: #0891b2;
            --badge-success-bg: #dcfce7; --badge-success-fg: #16a34a;
            --badge-failed-bg: #fee2e2; --badge-failed-fg: #dc2626;
            --badge-cancelled-bg: #fef3c7; --badge-cancelled-fg: #ca8a04;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg-primary: #1a1a2e;
                --bg-secondary: #16213e;
                --bg-tertiary: #0f3460;
                --text-primary: #e6e6e6;
                --text-secondary: #a0a0a0;
                --accent: #e94560;
                --success: #4ade80;
                --warning: #fbbf24;
                --error: #ef4444;
                --log-bg: #0d0d0d;
                --badge-pending-bg: #374151; --badge-pending-fg: #9ca3af;
                --badge-queued-bg: #1e3a5f; --badge-queued-fg: #60a5fa;
                --badge-running-bg: #164e63; --badge-running-fg: #22d3ee;
                --badge-success-bg: #14532d; --badge-success-fg: #4ade80;
                --badge-failed-bg: #450a0a; --badge-failed-fg: #f87171;
                --badge-cancelled-bg: #422006; --badge-cancelled-fg: #fbbf24;
            }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
        }
        .layout {
            display: flex;
            min-height: 100vh;
        }
        .sidebar {
            width: 220px;
            background-color: var(--bg-secondary);
            padding: 1rem;
            border-right: 1px solid var(--bg-tertiary);
        }
        .sidebar h1 {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            color: var(--accent);
        }
        .sidebar nav a {
            display: block;
            padding: 0.75rem 1rem;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
        }
        .sidebar nav a:hover {
            background-color: var(--bg-tertiary);
            color: var(--text-primary);
        }
        .main-content {
            flex: 1;
            padding: 2rem;
            overflow-x: auto;
        }
        .page-title {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-primary);
        }
        .card {
            background-color: var(--bg-secondary);
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        .card-title {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }
        .card-value {
            font-size: 2rem;
            font-weight: bold;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 0.75rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--bg-tertiary);
        }
        th {
            color: var(--text-secondary);
            font-weight: 500;
            font-size: 0.875rem;
        }
        td { font-size: 0.875rem; }
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 500;
        }
        .status-pending { background-color: var(--badge-pending-bg); color: var(--badge-pending-fg); }
        .status-queued { background-color: var(--badge-queued-bg); color: var(--badge-queued-fg); }
        .status-running { background-color: var(--badge-running-bg); color: var(--badge-running-fg); }
        .status-success { background-color: var(--badge-success-bg); color: var(--badge-success-fg); }
        .status-failed { background-color: var(--badge-failed-bg); color: var(--badge-failed-fg); }
        .status-cancelled { background-color: var(--badge-cancelled-bg); color: var(--badge-cancelled-fg); }
        .connection-badge {
            display: inline-block;
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            margin-right: 0.5rem;
        }
        .connected { background-color: var(--success); }
        .disconnected { background-color: var(--error); }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; }
        .log-container {
            background-color: var(--log-bg);
            border-radius: 0.5rem;
            padding: 1rem;
            font-family: monospace;
            font-size: 0.875rem;
            max-height: 500px;
            overflow-y: auto;
        }
        .log-line {
            white-space: pre-wrap;
            word-break: break-all;
        }
        .log-stdout { color: var(--text-primary); }
        .log-stderr { color: var(--error); }
        .detail-grid {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 0.5rem;
        }
        .detail-label {
            color: var(--text-secondary);
            font-size: 0.875rem;
        }
        .detail-value {
            font-size: 0.875rem;
        }
        .btn {
            display: inline-block;
            padding: 0.5rem 1rem;
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 0.25rem;
            cursor: pointer;
            font-size: 0.875rem;
        }
        .btn:hover { opacity: 0.9; }
        .btn-danger { background-color: var(--error); }
        .btn-download {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: var(--bg-tertiary);
            color: var(--text-primary);
            border-radius: 0.25rem;
            font-size: 0.75rem;
            text-decoration: none;
        }
        .btn-download:hover {
            background-color: var(--accent);
            text-decoration: none;
        }
        .workspace-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.2rem 0.5rem;
            background-color: var(--bg-tertiary);
            border-radius: 0.25rem;
            font-size: 0.75rem;
            margin: 0.125rem;
        }
        .workspace-delete {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.7rem;
            padding: 0 0.2rem;
            line-height: 1;
            border-radius: 0.125rem;
        }
        .workspace-delete:hover { color: var(--error); }
        .workspace-delete:disabled { opacity: 0.3; cursor: not-allowed; }
    </style>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <script src="_framework/blazor.server.js"></script>
    <script>
        window.getBrowserTimeZone = () => Intl.DateTimeFormat().resolvedOptions().timeZone;
    </script>
</body>
</html>
