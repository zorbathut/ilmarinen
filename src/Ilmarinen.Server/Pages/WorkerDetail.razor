@page "/workers/{Id}"
@using Ilmarinen.Models
@using Ilmarinen.Protocol
@using Ilmarinen.Protocol.Requests
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Ilmarinen.Server.Services.Wake
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using System.Threading
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<WorkerDetail> Logger
@inject WorkspaceDeletionService DeletionService
@inject WorkerMessenger Messenger
@inject JobScheduler Scheduler
@inject UIEventService UIEvents
@inject NavigationManager Navigation
@inject WorkerBundleService BundleService
@inject WorkerWaker Waker

<h1 class="page-title">Worker @(worker?.Name ?? Id)</h1>

@if (worker != null)
{
    <div class="card">
        <div class="detail-grid">
            <span class="detail-label">ID</span>
            <span class="detail-value">@worker.Id</span>

            <span class="detail-label">Name</span>
            <span class="detail-value">@worker.Name</span>

            <span class="detail-label">Status</span>
            <span class="detail-value">
                <span class="connection-badge @WorkerBadge.GetBadgeClass(worker)"></span>
                @WorkerBadge.GetStatusLabel(worker)
                <span style="margin-left: 1rem;"><WorkerModeSelect Mode="worker.Mode" Disabled="savingMode" OnChange="SetMode" /></span>
                @if (modeError != null)
                {
                    <span style="margin-left: 1rem; color: var(--error);">@modeError</span>
                }
            </span>

            <span class="detail-label">Priority</span>
            <span class="detail-value">@worker.Priority.Name</span>

            <span class="detail-label">Current Jobs</span>
            <span class="detail-value"><JobsLink JobIds="worker.CurrentJobs" /></span>

            <span class="detail-label">Registered</span>
            <span class="detail-value">@worker.RegisteredAt.ToString("yyyy-MM-dd HH:mm:ss")</span>

            <span class="detail-label">Last Seen</span>
            <span class="detail-value">@worker.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</span>

            <span class="detail-label">Last IP</span>
            <span class="detail-value">@(worker.LastIpAddress ?? "-")</span>

            <span class="detail-label">Wake address</span>
            <span class="detail-value">
                <input type="text" @bind="macInput" placeholder="aa:bb:cc:dd:ee:ff" style="width: 12rem;"
                       title="The MAC address of this worker's host, for waking it with wake-on-LAN; empty if it can't be woken" />
                <button class="btn" style="margin-left: 0.5rem;" disabled="@savingMac" @onclick="SaveMac">Save</button>
                @if (!worker.IsConnected && worker.WakeMacAddress != null && Waker.Enabled)
                {
                    <button class="btn" style="margin-left: 0.5rem;" disabled="@waking" @onclick="WakeNow"
                            title="Send this worker's host a wake-on-LAN packet now">Wake</button>
                }
                @if (!Waker.Enabled)
                {
                    <span style="margin-left: 1rem; color: var(--text-secondary);">Waking is off: set Server__WakeAddress on the server.</span>
                }
                @if (wakeMessage != null)
                {
                    <span style="margin-left: 1rem; color: @(wakeMessageIsError ? "var(--error)" : "var(--text-secondary)");">@wakeMessage</span>
                }
            </span>

            <span class="detail-label">Bundle</span>
            <span class="detail-value">
                @if (worker.BundleHash == null)
                {
                    <span>-</span>
                }
                else
                {
                    <span title="@worker.BundleHash">@worker.BundleHash[..Math.Min(8, worker.BundleHash.Length)]</span>
                    @if (BundleService.CurrentHash != null && worker.BundleHash != BundleService.CurrentHash)
                    {
                        <span style="color: var(--warning, orange);"> (stale)</span>
                    }
                }
            </span>

            <span class="detail-label">Protocol</span>
            <span class="detail-value"><WorkerProtocolVersion Worker="worker" /></span>
        </div>
    </div>

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Workspaces</h2>
        @if (worker.Workspaces.Count > 0 || worker.ShowsMirrors)
        {
            <WorkspaceTable Workers="[worker]" StorageKey="worker-workspaces" Defaults="WorkspaceColumns" Exclude="WorkerOwnColumns"
                            Delete="target => DeleteWorkspace(target.Workspace)" IsDeleting="(_, workspace) => IsDeleting(workspace)" />
        }
        else
        {
            <p style="color: var(--text-secondary);">No workspaces</p>
        }
        <p style="color: var(--text-secondary);">
            Disk: <DiskFree Worker="worker" />
            @if (worker.DiskSpace is { } disk)
            {
                <span> · keeps @DisplayFormat.Size(disk.MinFreeBytes) free</span>
            }
            @if (worker.OtherUseBytes is { } other)
            {
                <span title="Space in use that isn't workspaces or git mirrors: the host's own files and, for a containerized worker, usually Docker's images and build cache. Deleting workspaces can't free it."> · other use @DisplayFormat.Size(other)</span>
            }
        </p>
        @if (WorkerBadge.GetStatusDetail(worker) is { } blocked)
        {
            <p style="color: var(--warning);">@blocked</p>
        }
    </div>

    @if (deleteError != null)
    {
        <div class="card" style="margin-top: 1rem; border-left: 3px solid var(--error);">
            <span style="color: var(--error);">@deleteError</span>
        </div>
    }

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Diagnostic</h2>
        @if (worker.Diagnostic != null)
        {
            <div class="detail-grid">
                <span class="detail-label">Status</span>
                <span class="detail-value diagnostic-status-@worker.Diagnostic.Status.ToString().ToLower()">
                    @worker.Diagnostic.Status
                </span>

                <span class="detail-label">Summary</span>
                <span class="detail-value">@worker.Diagnostic.Summary</span>

                <span class="detail-label">Last checked</span>
                <span class="detail-value">@worker.Diagnostic.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>

            @if (worker.Diagnostic.Steps.Count > 0)
            {
                <div class="table-scroll" style="margin-top: 1rem;">
                    <table class="diagnostic-step-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Step</th>
                                <th>Duration</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var step in worker.Diagnostic.Steps)
                            {
                                <tr>
                                    <td class="@StepClass(step)">
                                        @StepLabel(step)
                                    </td>
                                    <td><code>@step.Name</code></td>
                                    <td>@DiagnosticStepDuration(step.Duration)</td>
                                    <td>
                                        @if (step.Message != null)
                                        {
                                            <div class="diagnostic-step-message">@step.Message</div>
                                        }
                                        @if (step.Suggestion != null)
                                        {
                                            <div class="diagnostic-step-suggestion">Hint: @step.Suggestion</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <p style="color: var(--text-secondary);">No diagnostic reported yet.</p>
        }

        <div style="margin-top: 1rem;">
            <button class="btn" @onclick="RunDiagnostic"
                    disabled="@(!CanRunDiagnostic())"
                    title="@(CanRunDiagnostic() ? "" : "Worker is busy or offline")">
                @(IsDiagnosticRunning() ? "Running..." : "Run diagnostic")
            </button>
            @if (diagnosticError != null)
            {
                <span style="margin-left: 1rem; color: var(--error);">@diagnosticError</span>
            }
        </div>
    </div>

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Job History</h2>
        <JobTable Items="jobs" Estimates="estimates" StorageKey="worker-jobs" Defaults="JobColumns" Exclude="WorkerOwnColumns">
            <Empty>
                <div style="text-align: center; color: var(--text-secondary);">No jobs</div>
            </Empty>
        </JobTable>
    </div>
}
else if (loading)
{
    <div class="card">Loading...</div>
}
else
{
    <div class="card">Worker not found</div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private WorkerView? worker;
    private IReadOnlyList<JobInfo>? jobs;
    private IReadOnlyDictionary<Guid, TimeSpan> estimates = new Dictionary<Guid, TimeSpan>();
    private static readonly IReadOnlyList<string> JobColumns = ["id", "status", "repository", "ref", "script", "duration"];
    private static readonly IReadOnlyCollection<string> WorkerOwnColumns = ["worker"];
    private static readonly IReadOnlyList<string> WorkspaceColumns = ["workspace", "path", "size", "last-used", "delete"];
    private bool loading = true;
    private HashSet<string> deletingWorkspaces = new();
    private string? deleteError;
    private string? diagnosticError;
    private bool savingMode;
    private string? modeError;
    private string? macInput;
    private bool macLoaded;
    private bool savingMac;
    private bool waking;
    private string? wakeMessage;
    private bool wakeMessageIsError;

    private bool IsDiagnosticRunning() =>
        worker?.Diagnostic?.Status == DiagnosticStatus.Running;

    private bool CanRunDiagnostic() =>
        worker != null && worker.IsConnected && worker.CurrentJobs.Count == 0 && !IsDiagnosticRunning();

    // An advisory step reports an optional capability, so its absence is not a failure and must not read as one.
    private static bool IsUnavailableAdvisory(DiagnosticStepResult step)
    {
        return !step.Success && step.Kind == DiagnosticStepKind.Advisory;
    }

    private static string StepClass(DiagnosticStepResult step)
    {
        if (IsUnavailableAdvisory(step))
        {
            return "diagnostic-step-advisory";
        }

        return step.Success ? "diagnostic-step-ok" : "diagnostic-step-fail";
    }

    private static string StepLabel(DiagnosticStepResult step)
    {
        if (IsUnavailableAdvisory(step))
        {
            return "n/a";
        }

        return step.Success ? "ok" : "FAIL";
    }

    private static string DiagnosticStepDuration(TimeSpan d)
    {
        if (d.TotalSeconds < 1) return $"{d.TotalMilliseconds:0}ms";
        if (d.TotalSeconds < 60) return $"{d.TotalSeconds:0.0}s";
        return $"{(int)d.TotalMinutes}m{d.Seconds:00}s";
    }

    private async Task SetMode(WorkerMode mode)
    {
        if (worker == null)
        {
            return;
        }

        savingMode = true;
        modeError = null;
        try
        {
            if (!await Scheduler.SetWorkerModeAsync(worker.Id, mode))
            {
                modeError = "Worker not found.";
            }
            await RefreshAsync(worker.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Setting worker {WorkerId}'s mode failed", worker.Id);
            modeError = $"Failed to change the mode: {ex.Message}";
        }
        finally
        {
            savingMode = false;
        }
    }

    private async Task SaveMac()
    {
        if (worker == null)
        {
            return;
        }

        string? mac = null;
        if (!string.IsNullOrWhiteSpace(macInput))
        {
            mac = MagicPacket.Normalize(macInput);
            if (mac == null)
            {
                (wakeMessage, wakeMessageIsError) = ("Not a MAC address: use aa:bb:cc:dd:ee:ff.", true);
                return;
            }
        }

        savingMac = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var saved = await scope.ServiceProvider.GetRequiredService<WorkerRepository>().SetWakeMacAddressAsync(worker.Id, mac);
            (wakeMessage, wakeMessageIsError) = saved ? (mac == null ? "Cleared." : "Saved.", false) : ("Worker not found.", true);
            macInput = mac;
            await RefreshAsync(worker.Id);
        }
        catch (Exception ex)
        {
            (wakeMessage, wakeMessageIsError) = ($"Failed to save the wake address: {ex.Message}", true);
        }
        finally
        {
            savingMac = false;
        }
    }

    private async Task WakeNow()
    {
        if (worker == null)
        {
            return;
        }

        waking = true;
        try
        {
            (wakeMessage, wakeMessageIsError) = await Waker.WakeNowAsync(worker.Id, CancellationToken.None) switch
            {
                WakeRequestResult.Sent => ("Wake packet sent.", false),
                WakeRequestResult.NoMacAddress => ("No wake address is set.", true),
                WakeRequestResult.WakingOff => ("Waking is off on this server.", true),
                _ => ("Worker not found.", true)
            };
        }
        catch (Exception ex)
        {
            (wakeMessage, wakeMessageIsError) = ($"Failed to send the wake packet: {ex.Message}", true);
        }
        finally
        {
            waking = false;
        }
    }

    private async Task RunDiagnostic()
    {
        diagnosticError = null;
        if (!Guid.TryParse(Id, out var workerId))
            return;

        if (!await Scheduler.RequestDiagnosticAsync(workerId))
        {
            diagnosticError = "Worker not connected.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(Id, out var ulid))
        {
            await RefreshAsync(ulid);
        }
        loading = false;

        UIEvents.OnWorkersChanged += OnChanged;
        UIEvents.OnJobsChanged += OnChanged;
    }

    private async void OnChanged()
    {
        try
        {
            if (Guid.TryParse(Id, out var ulid))
            {
                await RefreshAsync(ulid);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException ex)
        {
            Logger.LogDebug(ex, "Worker page went away mid-refresh");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing the worker page failed");
        }
    }

    private async Task RefreshAsync(Guid ulid)
    {
        using var scope = ScopeFactory.CreateScope();
        var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();
        var jobRepo = scope.ServiceProvider.GetRequiredService<JobRepository>();
        worker = await workerRepo.GetByIdAsync(ulid) is { } view ? (await Scheduler.WithNoRoomAsync([view])).Single() : null;
        // Once: the page refreshes every second and on every change, and would otherwise overwrite what is being typed.
        if (worker != null && !macLoaded)
        {
            macInput = worker.WakeMacAddress;
            macLoaded = true;
        }

        // Assigned together: the job list re-renders every second, and new jobs shown against old estimates would mislabel any that just finished
        var fetchedJobs = await jobRepo.GetByWorkerAsync(ulid);
        var fetchedEstimates = await jobRepo.GetDurationEstimatesAsync(fetchedJobs);
        (jobs, estimates) = (fetchedJobs, fetchedEstimates);
    }

    private bool IsDeleting(string workspace) =>
        deletingWorkspaces.Contains(workspace);

    private async Task DeleteWorkspace(string workspace)
    {
        deletingWorkspaces.Add(workspace);
        deleteError = null;
        StateHasChanged();

        try
        {
            if (!WorkspaceConfig.IsValidName(workspace, out var validationError))
            {
                deleteError = validationError;
                return;
            }

            if (!Guid.TryParse(Id, out var workerId))
                return;

            using var scope = ScopeFactory.CreateScope();
            var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();

            var connectionId = workerRepo.FindConnectionIdByWorkerId(workerId);
            if (connectionId == null)
            {
                deleteError = "Worker not connected.";
                return;
            }

            var key = DeletionService.CreatePending(connectionId, workspace);
            Messenger.Send(connectionId, $"deletion of workspace {workspace}", client => client.DeleteWorkspace(workspace));
            var result = await DeletionService.WaitForResultAsync(key, TimeSpan.FromSeconds(30));

            if (result.Status == Ilmarinen.Protocol.DeleteWorkspaceStatus.Success)
            {
                workerRepo.RemoveWorkspace(connectionId, workspace);
            }
            else
            {
                deleteError = result.Error ?? "Workspace deletion failed.";
            }

            await RefreshAsync(workerId);
        }
        finally
        {
            deletingWorkspaces.Remove(workspace);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        UIEvents.OnWorkersChanged -= OnChanged;
        UIEvents.OnJobsChanged -= OnChanged;
    }
}
