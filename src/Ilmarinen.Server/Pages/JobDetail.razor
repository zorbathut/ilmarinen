@page "/jobs/{Id}"
@using Ilmarinen.Protocol
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject JobScheduler Scheduler
@inject UIEventService UIEvents
@inject NavigationManager Navigation

<h1 class="page-title">Job @Id</h1>

@if (job != null)
{
    <div class="card">
        <div class="card-split">
            <div class="detail-grid">
                <span class="detail-label">ID</span>
                <span class="detail-value">@job.Id</span>

                <span class="detail-label">Status</span>
                <span class="detail-value"><span class="status-badge status-@job.Status.ToString().ToLower()">@job.Status</span></span>

                <span class="detail-label">Repository</span>
                <span class="detail-value">@job.RepoUrl</span>

                <span class="detail-label">Ref</span>
                <span class="detail-value">@job.Ref</span>

                <span class="detail-label">Commit</span>
                <span class="detail-value"><code>@(job.Commit ?? "-")</code></span>

                <span class="detail-label">Script</span>
                <span class="detail-value">@job.ScriptPath</span>

                <span class="detail-label">Pipeline</span>
                <span class="detail-value"><PipelineLink PipelineId="job.PipelineId" PipelineName="@job.PipelineName" /></span>

                <span class="detail-label">Worker</span>
                <span class="detail-value"><WorkerLink WorkerId="job.WorkerId" WorkerName="@job.WorkerName" /></span>

                <span class="detail-label">Created</span>
                <span class="detail-value">@job.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>

                <span class="detail-label">Started</span>
                <span class="detail-value">@(job.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>

                <span class="detail-label">Completed</span>
                <span class="detail-value">@(job.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
            </div>

            <div class="card-actions">
                @if (job.Status is JobStatus.Pending or JobStatus.Queued or JobStatus.Running)
                {
                    <button class="btn btn-danger" @onclick="CancelJob">Cancel Job</button>
                }
                @if (job.Status is JobStatus.Failed or JobStatus.Cancelled)
                {
                    @if (job.CanRetry)
                    {
                        <button class="btn" @onclick="RetryJob">Retry</button>
                    }
                    else
                    {
                        <button class="btn" disabled title="@job.RetryBlockedReason">Retry</button>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Logs</h2>
        <LogViewer JobId="@jobGuid" IsStreaming="@(job.Status == JobStatus.Running)" />
    </div>

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Artifacts</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Size</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (job.Artifacts?.Count > 0)
                    {
                        @foreach (var artifact in job.Artifacts)
                        {
                            <tr>
                                <td>@artifact.Name</td>
                                <td>@FormatSize(artifact.Size)</td>
                                <td><a href="/api/jobs/@job.Id/artifacts/@artifact.Id/download" class="btn-download" download>Download</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-secondary);">No artifacts</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (loading)
{
    <div class="card">Loading...</div>
}
else
{
    <div class="card">Job not found</div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private JobInfo? job;
    private Guid jobGuid;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(Id, out jobGuid))
        {
            job = await FetchJobAsync(jobGuid);
        }
        loading = false;
        UIEvents.OnJobsChanged += OnJobsChanged;
    }

    private async void OnJobsChanged()
    {
        try
        {
            if (jobGuid != default)
            {
                job = await FetchJobAsync(jobGuid);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task<JobInfo?> FetchJobAsync(Guid id)
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<JobRepository>();
        return await repo.GetAsync(id);
    }

    private async Task CancelJob()
    {
        if (Guid.TryParse(Id, out var ulid))
        {
            await Scheduler.CancelJobAsync(ulid);
        }
    }

    private async Task RetryJob()
    {
        if (Guid.TryParse(Id, out var ulid))
        {
            using var scope = ScopeFactory.CreateScope();
            var jobRepo = scope.ServiceProvider.GetRequiredService<JobRepository>();
            var submission = await jobRepo.BuildRetrySubmissionAsync(ulid);
            if (submission != null)
            {
                var newJobId = await Scheduler.EnqueueJobAsync(submission);
                Navigation.NavigateTo($"/jobs/{newJobId}");
            }
        }
    }

    public void Dispose()
    {
        UIEvents.OnJobsChanged -= OnJobsChanged;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }
}
