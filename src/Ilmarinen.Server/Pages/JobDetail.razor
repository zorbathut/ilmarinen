@page "/jobs/{Id}"
@using Ilmarinen.Protocol
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject JobScheduler Scheduler
@inject UIEventService UIEvents
@inject NavigationManager Navigation
@inject ILogger<JobDetail> Logger

<h1 class="page-title">Job @Id</h1>

@if (job != null)
{
    <div class="card">
        <div class="card-split">
            <div class="detail-grid">
                <span class="detail-label">ID</span>
                <span class="detail-value">@job.Id</span>

                <span class="detail-label">Status</span>
                <span class="detail-value">
                    <span class="status-badge status-@job.Status.ToString().ToLower()">@job.Status</span>
                    @if (job.Status == JobStatus.Queued)
                    {
                        <WakingFor JobId="job.Id" />
                    }
                </span>

                <span class="detail-label">Repository</span>
                <span class="detail-value">@job.RepoUrl</span>

                <span class="detail-label">Ref</span>
                <span class="detail-value">@job.Ref</span>

                <span class="detail-label">Commit</span>
                <span class="detail-value"><code>@(job.Commit ?? "-")</code></span>

                <span class="detail-label">Script</span>
                <span class="detail-value">@job.ScriptPath</span>

                <span class="detail-label">Pipeline</span>
                <span class="detail-value"><PipelineLink PipelineId="job.PipelineId" PipelineName="@job.PipelineName" /></span>

                <span class="detail-label">Worker</span>
                <span class="detail-value"><WorkerLink WorkerId="job.WorkerId" WorkerName="@job.WorkerName" /></span>

                <span class="detail-label">Min Worker Priority</span>
                <span class="detail-value">@(job.MinWorkerPriority?.Name ?? "Any worker")</span>

                <span class="detail-label">Job Priority</span>
                <span class="detail-value">@job.Priority.Name</span>

                @if (job.DiskUse is { } disk)
                {
                    <span class="detail-label">Workspace</span>
                    <span class="detail-value">@DisplayFormat.Workspace(disk)</span>

                    <span class="detail-label">Disk Used</span>
                    <span class="detail-value" style="@(disk.StoppedForDisk ? "color: var(--warning, orange);" : "")">
                        @(disk.UsedBytes is { } used ? DisplayFormat.Size(used) : "unmeasured")
                        @if (disk.StoppedForDisk)
                        {
                            <span> · stopped: free space fell below the worker's floor</span>
                        }
                    </span>
                }

                <span class="detail-label">Created</span>
                <span class="detail-value">@job.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>

                <span class="detail-label">Started</span>
                <span class="detail-value">@(job.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>

                <span class="detail-label">Completed</span>
                <span class="detail-value">@(job.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>

                @if (job.StartedAt != null && job.CompletedAt != null)
                {
                    <span class="detail-label">Duration</span>
                    <span class="detail-value">@DisplayFormat.JobElapsed(job, DateTime.UtcNow)</span>
                }
                else if (job.StartedAt != null)
                {
                    <span class="detail-label">Elapsed</span>
                    <span class="detail-value"><ElapsedTime Job="job" /></span>

                    @if (estimate is TimeSpan expected)
                    {
                        <span class="detail-label">Estimated Duration</span>
                        <span class="detail-value">~@DisplayFormat.Duration(expected)</span>
                    }
                }
            </div>

            <div class="card-actions">
                @if (job.Status is JobStatus.Pending or JobStatus.Queued or JobStatus.Running)
                {
                    <button class="btn btn-danger" @onclick="CancelJob">Cancel Job</button>
                }
                @if (job.Status is JobStatus.Failed or JobStatus.Cancelled)
                {
                    @if (job.CanRetry)
                    {
                        <button class="btn" @onclick="RetryJob">Retry</button>
                    }
                    else
                    {
                        <button class="btn" disabled title="@job.RetryBlockedReason">Retry</button>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card" style="margin-top: 1rem;">
        <div class="card-split">
            <h2 class="card-title">Logs</h2>
            <div class="log-links">
                <a href="/jobs/@job.Id/logs" class="btn-download">Full screen</a>
                @* The download attribute stops Blazor from intercepting the click: otherwise the router takes the /api path first, matches no page, and only then force-loads it — a needless round trip through the circuit, and one that needs the circuit to be alive. *@
                <a href="/api/jobs/@job.Id/logs/download" class="btn-download" download>Download</a>
            </div>
        </div>
        <LogViewer @key="job.Id" JobId="@job.Id" InitialStatus="@job.Status" Class="log-embed" />
    </div>

    <JobMetrics @key="job.Id" JobId="@job.Id" Status="@job.Status" />

    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Artifacts</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Size</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (job.Artifacts?.Count > 0)
                    {
                        @foreach (var artifact in job.Artifacts)
                        {
                            <tr>
                                <td>@artifact.Name</td>
                                <td>@DisplayFormat.Size(artifact.Size)</td>
                                <td><a href="/api/jobs/@job.Id/artifacts/@artifact.Id/download" class="btn-download" download>Download</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-secondary);">No artifacts</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (loading)
{
    <div class="card">Loading...</div>
}
else
{
    <div class="card">Job not found</div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private JobInfo? job;
    private TimeSpan? estimate;
    private Guid jobGuid;
    private string? loadedId;
    private bool loading = true;

    protected override void OnInitialized()
    {
        UIEvents.OnJobsChanged += OnJobsChanged;
    }

    // The router reuses this component across /jobs/{a} → /jobs/{b} — which is exactly what Retry does — so the lookup belongs here rather than in OnInitializedAsync, which would keep showing the first job under the second job's URL.
    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId)
        {
            return;
        }

        loadedId = Id;
        job = null;
        estimate = null;
        loading = true;
        jobGuid = Guid.TryParse(Id, out var parsed) ? parsed : default;

        if (jobGuid != default)
        {
            (job, estimate) = await FetchJobAsync(jobGuid);
        }

        loading = false;
    }

    private async void OnJobsChanged()
    {
        try
        {
            if (jobGuid == default)
            {
                return;
            }

            // Fired from a scheduler thread, so the page can navigate to another job while this fetch is in flight; that job's own load owns the result then.
            var fetchedFor = jobGuid;
            var fetched = await FetchJobAsync(fetchedFor);

            if (fetchedFor != jobGuid)
            {
                return;
            }

            (job, estimate) = fetched;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing job {JobId} after a job-change event failed", jobGuid);
        }
    }

    private async Task<(JobInfo? Job, TimeSpan? Estimate)> FetchJobAsync(Guid id)
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<JobRepository>();
        var fetched = await repo.GetAsync(id);
        if (fetched == null)
        {
            return (null, null);
        }

        var estimates = await repo.GetDurationEstimatesAsync([fetched]);
        return (fetched, estimates.TryGetValue(fetched.Id, out var expected) ? expected : null);
    }

    private async Task CancelJob()
    {
        if (Guid.TryParse(Id, out var ulid))
        {
            await Scheduler.CancelJobAsync(ulid);
        }
    }

    private async Task RetryJob()
    {
        if (Guid.TryParse(Id, out var ulid))
        {
            using var scope = ScopeFactory.CreateScope();
            var jobRepo = scope.ServiceProvider.GetRequiredService<JobRepository>();
            var submission = await jobRepo.BuildRetrySubmissionAsync(ulid);
            if (submission != null)
            {
                var newJobId = await Scheduler.EnqueueJobAsync(submission);
                Navigation.NavigateTo($"/jobs/{newJobId}");
            }
        }
    }

    public void Dispose()
    {
        UIEvents.OnJobsChanged -= OnJobsChanged;
    }
}
