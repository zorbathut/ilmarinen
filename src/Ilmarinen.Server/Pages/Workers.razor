@page "/workers"
@using Ilmarinen.Protocol
@using Ilmarinen.Server.Services
@using Ilmarinen.Models
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Workers> Logger
@inject WorkerRegistrationService RegistrationService
@inject WorkspaceDeletionService DeletionService
@inject WorkerMessenger Messenger
@inject JobScheduler Scheduler
@inject UIEventService UIEvents
@inject WorkerBundleService BundleService

<h1 class="page-title">Workers</h1>

<FilteredByPriority PriorityId="PriorityFilter" What="workers of priority" ClearHref="/workers" />

<div class="card" style="margin-bottom: 1rem;">
    <h3>Register Worker</h3>
    <form @onsubmit="RegisterWorker" class="form-row">
        <div>
            <label for="workerName">Name</label>
            <input id="workerName" type="text" @bind="newWorkerName" placeholder="e.g. build-worker-1" />
        </div>
        <button type="submit" class="btn" disabled="@isRegistering">Register</button>
    </form>
    @if (registrationError != null)
    {
        <div style="margin-top: 0.5rem; color: var(--error);">@registrationError</div>
    }
</div>

@if (registrationResult != null)
{
    <div class="card" style="margin-bottom: 1rem; border-left: 3px solid var(--warning, orange);">
        <h3>Worker Registered</h3>
        <p><strong>Worker ID:</strong> @registrationResult.WorkerId</p>
        <p><strong>Worker Key:</strong></p>
        <code style="display: block; padding: 0.5rem; background: var(--bg-secondary, #1a1a1a); word-break: break-all; font-size: 0.85em;">@registrationResult.WorkerKey</code>
        <p style="margin-top: 0.5rem;">Set as <code>ILMARINEN_WORKER_KEY</code> environment variable on the worker.</p>
        <p style="color: var(--warning, orange);"><strong>Save this key now. It cannot be retrieved again.</strong></p>
        <button class="btn" @onclick="DismissRegistration">Dismiss</button>
    </div>
}

<div class="card">
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Name</th>
                    <th class="hide-mobile">ID</th>
                    <th>Priority</th>
                    <th>Current Job</th>
                    <th>Disk Free</th>
                    <th class="hide-mobile">Bundle</th>
                    <th class="hide-mobile">Protocol</th>
                    <th class="hide-mobile">Registered</th>
                    <th class="hide-mobile">Last Seen</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (workers != null)
                {
                    @foreach (var worker in workers)
                    {
                        <tr @key="worker.Id">
                            <td>
                                <span class="connection-badge @WorkerBadge.GetBadgeClass(worker)"></span>
                                @WorkerBadge.GetStatusLabel(worker)
                            </td>
                            <td><WorkerLink WorkerId="worker.Id" WorkerName="@worker.Name" /></td>
                            <td class="hide-mobile">@ShortId.From(worker.Id)</td>
                            <td>
                                @* Keyed on the save counter as well as the value: a failed save leaves the stored priority unchanged, so without this the diff is a no-op and the dropdown would keep showing the value the user picked instead of the one that is actually stored. *@
                                <select @key="(worker.Priority, prioritySaves)"
                                        value="@worker.Priority.Id"
                                        disabled="@IsSavingPriority(worker.Id)"
                                        @onchange="e => SetPriority(worker.Id, e)">
                                    @foreach (var priority in priorityOptions)
                                    {
                                        <option value="@priority.Id" selected="@(priority.Id == worker.Priority.Id)">@priority.Name</option>
                                    }
                                </select>
                            </td>
                            <td><JobsLink JobIds="worker.CurrentJobs" /></td>
                            <td><DiskFree Worker="worker" /></td>
                            <td class="hide-mobile">
                                @if (worker.BundleHash == null)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    @* The hash is worker-reported; don't let a short one crash the render *@
                                    <span title="@worker.BundleHash">@worker.BundleHash[..Math.Min(8, worker.BundleHash.Length)]</span>
                                    @if (BundleService.CurrentHash != null && worker.BundleHash != BundleService.CurrentHash)
                                    {
                                        <span style="color: var(--warning, orange);"> (stale)</span>
                                    }
                                }
                            </td>
                            <td class="hide-mobile"><WorkerProtocolVersion Worker="worker" /></td>
                            <td class="hide-mobile">@worker.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="hide-mobile">@worker.LastSeen.ToString("HH:mm:ss")</td>
                            <td>
                                <button class="btn"
                                        disabled="@IsSavingPause(worker.Id)"
                                        title="@(worker.IsPaused ? "Let the server send this worker jobs again" : "Send this worker no new jobs; what it is running carries on")"
                                        @onclick="() => TogglePause(worker)">@(worker.IsPaused ? "Unpause" : "Pause")</button>
                                <button class="btn btn-danger"
                                        disabled="@IsRevoking(worker.Id)"
                                        @onclick="() => RevokeWorker(worker.Id)">Revoke</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (workers != null && workers.Any(w => w.Workspaces.Count > 0 || w.ShowsMirrors))
{
    <div class="card" style="margin-top: 1rem;">
        <h2 class="card-title">Workspaces</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Worker</th>
                        <th>Workspace</th>
                        <th>Size</th>
                        <th>Last Used</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in workers)
                    {
                        @foreach (var ws in worker.Workspaces.OrderByDescending(ws => ws.LastUsed))
                        {
                            <tr @key="(worker.Id, ws.Name)">
                                <td><WorkerLink WorkerId="worker.Id" WorkerName="@worker.Name" /></td>
                                <td>
                                    @ws.Name
                                    <WorkspaceInUse Workspace="ws" />
                                </td>
                                <td>@DisplayFormat.MeasuredSize(ws.Measured, ws.SizeBytes)</td>
                                <td><TimeAgo When="ws.LastUsed" /></td>
                                <td>
                                    @if (worker.IsConnected)
                                    {
                                        <button class="btn btn-danger"
                                                disabled="@(ws.InUse || IsDeleting(worker.Id, ws.Name))"
                                                title="@(ws.InUse ? WorkspaceInUse.Reason : null)"
                                                @onclick="() => DeleteWorkspace(worker.Id, ws.Name)">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (worker.ShowsMirrors)
                        {
                            <tr @key="(worker.Id, MirrorsRowKey)">
                                <td><WorkerLink WorkerId="worker.Id" WorkerName="@worker.Name" /></td>
                                <td><em>git mirrors</em></td>
                                <td>@DisplayFormat.MeasuredSize(true, worker.MirrorsSizeBytes)</td>
                                <td>-</td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (actionError != null)
{
    <div class="card" style="margin-top: 1rem; border-left: 3px solid var(--error);">
        <span style="color: var(--error);">@actionError</span>
    </div>
}

@code {
    // Highest first — the dropdown should read the way the scheduler prefers.
    private IReadOnlyList<PriorityRef> priorityOptions = [];

    private IReadOnlyList<WorkerView>? workers;
    private HashSet<string> deletingWorkspaces = new();
    private HashSet<string> revokingWorkers = new();
    private HashSet<Guid> savingPriority = new();
    private HashSet<Guid> savingPause = new();
    private int prioritySaves;
    private string? actionError;
    private string newWorkerName = "";
    private bool isRegistering;
    private string? registrationError;
    private WorkerRegistrationResult? registrationResult;

    /// <summary>Only the workers of this priority.</summary>
    [SupplyParameterFromQuery(Name = "priority")]
    public Guid? PriorityFilter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        workers = await FetchWorkersAsync();
    }

    protected override void OnInitialized()
    {
        UIEvents.OnWorkersChanged += OnChanged;
        UIEvents.OnJobsChanged += OnChanged;
        UIEvents.OnPrioritiesChanged += OnChanged;
    }

    private async void OnChanged()
    {
        try
        {
            workers = await FetchWorkersAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException ex)
        {
            Logger.LogDebug(ex, "Workers page went away mid-refresh");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Refreshing the workers page failed");
        }
    }

    private async Task<IReadOnlyList<WorkerView>> FetchWorkersAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();
        var priorities = scope.ServiceProvider.GetRequiredService<PriorityRepository>();
        priorityOptions = (await priorities.GetAllAsync(PriorityKind.Worker)).Select(PriorityRepository.ToRef).ToList();
        return await repo.GetAllAsync(PriorityFilter);
    }

    public void Dispose()
    {
        UIEvents.OnWorkersChanged -= OnChanged;
        UIEvents.OnPrioritiesChanged -= OnChanged;
        UIEvents.OnJobsChanged -= OnChanged;
    }

    // Workspace names can't start with a dot, so this never collides with one
    private const string MirrorsRowKey = ".mirrors";

    private bool IsDeleting(Guid workerId, string workspace) =>
        deletingWorkspaces.Contains($"{workerId}:{workspace}");

    private bool IsRevoking(Guid workerId) =>
        revokingWorkers.Contains(workerId.ToString());

    private bool IsSavingPriority(Guid workerId) =>
        savingPriority.Contains(workerId);

    private bool IsSavingPause(Guid workerId) =>
        savingPause.Contains(workerId);

    private async Task TogglePause(WorkerView worker)
    {
        savingPause.Add(worker.Id);
        actionError = null;
        StateHasChanged();

        try
        {
            if (!await Scheduler.SetWorkerPausedAsync(worker.Id, !worker.IsPaused))
            {
                actionError = "Worker not found.";
            }

            workers = await FetchWorkersAsync();
        }
        catch (Exception ex)
        {
            actionError = $"Failed to change pause: {ex.Message}";
        }
        finally
        {
            savingPause.Remove(worker.Id);
            StateHasChanged();
        }
    }

    private async Task SetPriority(Guid workerId, ChangeEventArgs e)
    {
        var priority = Guid.Parse((string)e.Value!);

        savingPriority.Add(workerId);
        actionError = null;
        StateHasChanged();

        try
        {
            if (!await Scheduler.SetWorkerPriorityAsync(workerId, priority))
            {
                actionError = "Worker not found.";
            }

            workers = await FetchWorkersAsync();
        }
        catch (Exception ex)
        {
            actionError = $"Failed to set priority: {ex.Message}";
        }
        finally
        {
            savingPriority.Remove(workerId);
            prioritySaves++;
            StateHasChanged();
        }
    }

    private async Task RegisterWorker()
    {
        isRegistering = true;
        registrationError = null;
        registrationResult = null;
        StateHasChanged();

        try
        {
            registrationResult = await RegistrationService.RegisterWorkerAsync(newWorkerName.Trim());
            newWorkerName = "";
            workers = await FetchWorkersAsync();
        }
        catch (ArgumentException ex)
        {
            registrationError = ex.Message;
        }
        catch (ConfigurationException ex)
        {
            registrationError = ex.Message;
        }
        finally
        {
            isRegistering = false;
            StateHasChanged();
        }
    }

    private void DismissRegistration()
    {
        registrationResult = null;
    }

    private async Task RevokeWorker(Guid workerId)
    {
        var key = workerId.ToString();
        revokingWorkers.Add(key);
        actionError = null;
        StateHasChanged();

        try
        {
            await RegistrationService.RevokeWorkerAsync(workerId);
            workers = await FetchWorkersAsync();
        }
        catch (Exception ex)
        {
            actionError = $"Failed to revoke worker: {ex.Message}";
        }
        finally
        {
            revokingWorkers.Remove(key);
            StateHasChanged();
        }
    }

    private async Task DeleteWorkspace(Guid workerId, string workspace)
    {
        var deleteKey = $"{workerId}:{workspace}";
        deletingWorkspaces.Add(deleteKey);
        actionError = null;
        StateHasChanged();

        try
        {
            if (!WorkspaceConfig.IsValidName(workspace, out var validationError))
            {
                actionError = validationError;
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();

            var connectionId = workerRepo.FindConnectionIdByWorkerId(workerId);
            if (connectionId == null)
            {
                actionError = "Worker not found or not connected.";
                return;
            }

            var key = DeletionService.CreatePending(connectionId, workspace);
            Messenger.Send(connectionId, $"deletion of workspace {workspace}", client => client.DeleteWorkspace(workspace));
            var result = await DeletionService.WaitForResultAsync(key, TimeSpan.FromSeconds(30));

            if (result.Status == Ilmarinen.Protocol.DeleteWorkspaceStatus.Success)
            {
                workerRepo.RemoveWorkspace(connectionId, workspace);
            }
            else
            {
                actionError = result.Error ?? "Workspace deletion failed.";
            }

            workers = await FetchWorkersAsync();
        }
        finally
        {
            deletingWorkspaces.Remove(deleteKey);
            StateHasChanged();
        }
    }
}
