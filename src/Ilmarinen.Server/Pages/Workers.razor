@page "/workers"
@using Ilmarinen.Protocol
@using Ilmarinen.Server.Hubs
@using Ilmarinen.Server.Services
@using Ilmarinen.Models
@using Microsoft.AspNetCore.SignalR
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject WorkerRegistrationService RegistrationService
@inject WorkspaceDeletionService DeletionService
@inject IHubContext<WorkerHub, IWorkerClient> HubContext
@inject UIEventService UIEvents

<h1 class="page-title">Workers</h1>

<div class="card" style="margin-bottom: 1rem;">
    <h3>Register Worker</h3>
    <form @onsubmit="RegisterWorker" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <div>
            <label for="workerName">Name</label>
            <input id="workerName" type="text" @bind="newWorkerName" placeholder="e.g. build-worker-1" />
        </div>
        <button type="submit" disabled="@isRegistering">Register</button>
    </form>
    @if (registrationError != null)
    {
        <div style="margin-top: 0.5rem; color: var(--error);">@registrationError</div>
    }
</div>

@if (registrationResult != null)
{
    <div class="card" style="margin-bottom: 1rem; border-left: 3px solid var(--warning, orange);">
        <h3>Worker Registered</h3>
        <p><strong>Worker ID:</strong> @registrationResult.WorkerId</p>
        <p><strong>Worker Key:</strong></p>
        <code style="display: block; padding: 0.5rem; background: var(--bg-secondary, #1a1a1a); word-break: break-all; font-size: 0.85em;">@registrationResult.WorkerKey</code>
        <p style="margin-top: 0.5rem;">Set as <code>ILMARINEN_WORKER_KEY</code> environment variable on the worker.</p>
        <p style="color: var(--warning, orange);"><strong>Save this key now. It cannot be retrieved again.</strong></p>
        <button @onclick="DismissRegistration">Dismiss</button>
    </div>
}

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Status</th>
                <th>Name</th>
                <th>ID</th>
                <th>Priority</th>
                <th>Current Job</th>
                <th>Workspaces</th>
                <th>Registered</th>
                <th>Last Seen</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (workers != null)
            {
                @foreach (var worker in workers)
                {
                    <tr @key="worker.Id">
                        <td>
                            <span class="connection-badge @WorkerBadge.GetBadgeClass(worker)"></span>
                            @WorkerBadge.GetStatusLabel(worker)
                        </td>
                        <td><WorkerLink WorkerId="worker.Id" WorkerName="@worker.Name" /></td>
                        <td>@worker.Id.ToString()[..8]</td>
                        <td>
                            @* Keyed on the save counter as well as the value: a failed save leaves the stored priority unchanged, so without this the diff is a no-op and the dropdown would keep showing the value the user picked instead of the one that is actually stored. *@
                            <select @key="(worker.Priority, prioritySaves)"
                                    value="@worker.Priority"
                                    disabled="@IsSavingPriority(worker.Id)"
                                    @onchange="e => SetPriority(worker.Id, e)">
                                @foreach (var priority in PriorityOptions)
                                {
                                    <option value="@priority" selected="@(priority == worker.Priority)">@priority</option>
                                }
                            </select>
                        </td>
                        <td><JobsLink JobIds="worker.CurrentJobs" /></td>
                        <td>
                            @if (worker.Workspaces.Count > 0)
                            {
                                @foreach (var ws in worker.Workspaces)
                                {
                                    <span class="workspace-tag">
                                        @ws.Name
                                        @if (worker.IsConnected)
                                        {
                                            <button class="workspace-delete"
                                                    disabled="@IsDeleting(worker.Id, ws.Name)"
                                                    @onclick="() => DeleteWorkspace(worker.Id, ws.Name)">x</button>
                                        }
                                    </span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@worker.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@worker.LastSeen.ToString("HH:mm:ss")</td>
                        <td>
                            <button class="btn-danger"
                                    disabled="@IsRevoking(worker.Id)"
                                    @onclick="() => RevokeWorker(worker.Id)">Revoke</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (actionError != null)
{
    <div class="card" style="margin-top: 1rem; border-left: 3px solid var(--error);">
        <span style="color: var(--error);">@actionError</span>
    </div>
}

@code {
    // Highest first — the dropdown should read the way the scheduler prefers.
    private static readonly WorkerPriority[] PriorityOptions = [WorkerPriority.High, WorkerPriority.Medium, WorkerPriority.Low];

    private IReadOnlyList<WorkerView>? workers;
    private HashSet<string> deletingWorkspaces = new();
    private HashSet<string> revokingWorkers = new();
    private HashSet<Guid> savingPriority = new();
    private int prioritySaves;
    private string? actionError;
    private string newWorkerName = "";
    private bool isRegistering;
    private string? registrationError;
    private WorkerRegistrationResult? registrationResult;

    protected override async Task OnInitializedAsync()
    {
        workers = await FetchWorkersAsync();
        UIEvents.OnWorkersChanged += OnChanged;
        UIEvents.OnJobsChanged += OnChanged;
    }

    private async void OnChanged()
    {
        try
        {
            workers = await FetchWorkersAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task<IReadOnlyList<WorkerView>> FetchWorkersAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();
        return await repo.GetAllAsync();
    }

    public void Dispose()
    {
        UIEvents.OnWorkersChanged -= OnChanged;
        UIEvents.OnJobsChanged -= OnChanged;
    }

    private bool IsDeleting(Guid workerId, string workspace) =>
        deletingWorkspaces.Contains($"{workerId}:{workspace}");

    private bool IsRevoking(Guid workerId) =>
        revokingWorkers.Contains(workerId.ToString());

    private bool IsSavingPriority(Guid workerId) =>
        savingPriority.Contains(workerId);

    private async Task SetPriority(Guid workerId, ChangeEventArgs e)
    {
        var priority = Enum.Parse<WorkerPriority>((string)e.Value!);

        savingPriority.Add(workerId);
        actionError = null;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();

            if (!await workerRepo.SetPriorityAsync(workerId, priority))
            {
                actionError = "Worker not found.";
            }

            workers = await FetchWorkersAsync();

            // The dashboard writes through the repository rather than the controller, so nothing else tells other open browsers to refresh.
            UIEvents.NotifyWorkersChanged();
        }
        catch (Exception ex)
        {
            actionError = $"Failed to set priority: {ex.Message}";
        }
        finally
        {
            savingPriority.Remove(workerId);
            prioritySaves++;
            StateHasChanged();
        }
    }

    private async Task RegisterWorker()
    {
        isRegistering = true;
        registrationError = null;
        registrationResult = null;
        StateHasChanged();

        try
        {
            registrationResult = await RegistrationService.RegisterWorkerAsync(newWorkerName.Trim());
            newWorkerName = "";
            workers = await FetchWorkersAsync();
        }
        catch (ArgumentException ex)
        {
            registrationError = ex.Message;
        }
        catch (ConfigurationException ex)
        {
            registrationError = ex.Message;
        }
        finally
        {
            isRegistering = false;
            StateHasChanged();
        }
    }

    private void DismissRegistration()
    {
        registrationResult = null;
    }

    private async Task RevokeWorker(Guid workerId)
    {
        var key = workerId.ToString();
        revokingWorkers.Add(key);
        actionError = null;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();

            var connectionId = workerRepo.FindConnectionIdByWorkerId(workerId);
            if (connectionId != null)
            {
                await workerRepo.SetDisconnectedAsync(connectionId);
            }

            await RegistrationService.RevokeWorkerAsync(workerId);
            workers = await FetchWorkersAsync();
        }
        catch (Exception ex)
        {
            actionError = $"Failed to revoke worker: {ex.Message}";
        }
        finally
        {
            revokingWorkers.Remove(key);
            StateHasChanged();
        }
    }

    private async Task DeleteWorkspace(Guid workerId, string workspace)
    {
        var deleteKey = $"{workerId}:{workspace}";
        deletingWorkspaces.Add(deleteKey);
        actionError = null;
        StateHasChanged();

        try
        {
            if (!WorkspaceConfig.IsValidName(workspace, out var validationError))
            {
                actionError = validationError;
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var workerRepo = scope.ServiceProvider.GetRequiredService<WorkerRepository>();

            var connectionId = workerRepo.FindConnectionIdByWorkerId(workerId);
            if (connectionId == null)
            {
                actionError = "Worker not found or not connected.";
                return;
            }

            var key = DeletionService.CreatePending(connectionId, workspace);
            await HubContext.Clients.Client(connectionId).DeleteWorkspace(workspace);
            var result = await DeletionService.WaitForResultAsync(key, TimeSpan.FromSeconds(30));

            if (result.Status == Ilmarinen.Protocol.DeleteWorkspaceStatus.Success)
            {
                workerRepo.RemoveWorkspace(connectionId, workspace);
            }
            else
            {
                actionError = result.Error ?? "Workspace deletion failed.";
            }

            workers = await FetchWorkersAsync();
        }
        finally
        {
            deletingWorkspaces.Remove(deleteKey);
            StateHasChanged();
        }
    }
}
