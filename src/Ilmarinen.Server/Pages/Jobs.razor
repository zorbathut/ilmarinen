@page "/jobs"
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@using System.Threading
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject UIEventService UIEvents

<h1 class="page-title">Jobs</h1>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Repository</th>
                <th>Ref</th>
                <th>Script</th>
                <th>Worker</th>
                <th>Duration</th>
            </tr>
        </thead>
        <tbody>
            @if (jobs != null)
            {
                @foreach (var job in jobs)
                {
                    <tr>
                        <td><JobLink JobId="job.Id" /></td>
                        <td><span class="status-badge status-@job.Status.ToString().ToLower()">@job.Status</span></td>
                        <td>@GetShortRepoUrl(job.RepoUrl)</td>
                        <td>@job.Ref</td>
                        <td>@job.ScriptPath</td>
                        <td><WorkerLink WorkerId="job.WorkerId" WorkerName="@job.WorkerName" /></td>
                        <td>@FormatDuration(job)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<JobInfo>? jobs;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        jobs = await FetchJobsAsync();

        UIEvents.OnJobsChanged += OnJobsChanged;

        // Tick every second to update running job durations
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async void OnJobsChanged()
    {
        try
        {
            jobs = await FetchJobsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Page may have been disposed
        }
    }

    private async Task<IReadOnlyList<JobInfo>> FetchJobsAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var repo = scope.ServiceProvider.GetRequiredService<JobRepository>();
        return await repo.GetAllAsync();
    }

    private static string FormatDuration(JobInfo job)
    {
        if (job.StartedAt == null)
            return "---";

        var end = job.CompletedAt ?? DateTime.UtcNow;
        var duration = end - job.StartedAt.Value;

        if (duration.TotalMinutes < 1)
            return $"{duration.Seconds}s";
        if (duration.TotalHours < 1)
            return $"{duration.Minutes}m {duration.Seconds}s";
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }

    private string GetShortRepoUrl(string url)
    {
        if (url.StartsWith("https://github.com/"))
            return url.Replace("https://github.com/", "");
        if (url.StartsWith("git@github.com:"))
            return url.Replace("git@github.com:", "").Replace(".git", "");
        return url;
    }

    public void Dispose()
    {
        UIEvents.OnJobsChanged -= OnJobsChanged;
        _timer?.Dispose();
    }
}
