@page "/pipelines"
@using Ilmarinen.Protocol
@using Ilmarinen.Protocol.Requests
@using Ilmarinen.Protocol.Responses
@using Ilmarinen.Server.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject UIEventService UIEvents
@inject BrowserTimeZone TimeZone

<h1 class="page-title">Pipelines</h1>

<div class="card" style="margin-bottom: 1rem;">
    <h2 class="card-title" style="font-size: 1.25rem; margin-bottom: 1rem;">Create Pipeline</h2>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="error-message">@error</div>
    }
    <div class="form-grid">
        <div>
            <label>Name</label>
            <input type="text" @bind="newName" placeholder="my-pipeline" />
        </div>
        <div>
            <label>Repository</label>
            <select @bind="newRepositoryId">
                <option value="">Select a repository...</option>
                @if (repositories != null)
                {
                    @foreach (var repo in repositories)
                    {
                        <option value="@repo.Id">@repo.Name (@DisplayFormat.ShortRepoUrl(repo.RepoUrl))</option>
                    }
                }
            </select>
        </div>
        <div>
            <label>Default Ref</label>
            <input type="text" @bind="newDefaultRef" placeholder="main" />
        </div>
        <div>
            <label>Script Path</label>
            <input type="text" @bind="newScriptPath" placeholder="pipeline.csx" />
        </div>
        <div>
            <label>Schedule (optional, cron in your local time)</label>
            <input type="text" @bind="newSchedule" placeholder="0 2 * * *" />
        </div>
        <div>
            <label>Min Worker Priority</label>
            <select @bind="newMinWorkerPriority">
                <option value="@PriorityNames.AnyWorker">Any worker</option>
                @foreach (var priority in workerPriorities)
                {
                    <option value="@priority.Name">@priority.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Job Priority</label>
            <select @bind="newPriority">
                @foreach (var priority in jobPriorities)
                {
                    <option value="@priority.Name">@priority.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Notifications</label>
            <select @bind="newNotificationPolicy">
                @foreach (var policy in Enum.GetValues<NotificationPolicy>())
                {
                    <option value="@policy">@policy</option>
                }
            </select>
        </div>
    </div>
    <button class="btn" @onclick="CreatePipeline" disabled="@creating">
        @(creating ? "Creating..." : "Create Pipeline")
    </button>
</div>

<FilteredByPriority PriorityId="PriorityFilter" What="pipelines of job priority" ClearHref="/pipelines" />
<FilteredByPriority PriorityId="MinWorkerPriorityFilter" What="pipelines needing worker priority" ClearHref="/pipelines" />

<div class="card">
    <PipelineTable Items="pipelines" StorageKey="pipelines" Defaults="PipelineColumns" />
</div>

@code {
    private TimeZoneInfo? _browserTz;
    private IReadOnlyList<PipelineInfo>? pipelines;
    private static readonly IReadOnlyList<string> PipelineColumns = ["name", "repository", "default-ref", "script", "schedule", "created"];
    private IReadOnlyList<RepositoryInfo>? repositories;
    private string newName = "";
    private string newRepositoryId = "";
    private string newDefaultRef = "main";
    private string newScriptPath = "";
    private string newSchedule = "";
    // By name, as a submission gives them; the lists are highest first.
    private IReadOnlyList<Ilmarinen.Database.Entities.Priority> workerPriorities = [];
    private IReadOnlyList<Ilmarinen.Database.Entities.Priority> jobPriorities = [];
    private string newMinWorkerPriority = PriorityNames.AnyWorker;
    private string newPriority = "";
    private NotificationPolicy newNotificationPolicy = NotificationPolicy.All;
    private string? error;
    private bool creating;

    /// <summary>Only the pipelines of this job priority.</summary>
    [SupplyParameterFromQuery(Name = "priority")]
    public Guid? PriorityFilter { get; set; }

    /// <summary>Only the pipelines needing this worker priority.</summary>
    [SupplyParameterFromQuery(Name = "minWorkerPriority")]
    public Guid? MinWorkerPriorityFilter { get; set; }

    /// <summary>Each read or write in a scope of its own: a context held for the page's life would serve priorities as they were when it first read them.</summary>
    private async Task<T> InScopeAsync<T>(Func<IServiceProvider, Task<T>> use)
    {
        using var scope = ScopeFactory.CreateScope();
        return await use(scope.ServiceProvider);
    }

    // Raised from whichever circuit changed the priorities; the choices here follow.
    private async void OnPrioritiesChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadPrioritiesAsync();
                pipelines = await InScopeAsync(s => s.GetRequiredService<PipelineRepository>().GetAllAsync(PriorityFilter, MinWorkerPriorityFilter));
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            error = $"Reloading the priorities failed: {ex.Message}";
        }
    }

    public void Dispose()
    {
        UIEvents.OnPrioritiesChanged -= OnPrioritiesChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        UIEvents.OnPrioritiesChanged += OnPrioritiesChanged;
        repositories = await InScopeAsync(s => s.GetRequiredService<RepositoryRepository>().GetAllAsync());
        await LoadPrioritiesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        pipelines = await InScopeAsync(s => s.GetRequiredService<PipelineRepository>().GetAllAsync(PriorityFilter, MinWorkerPriorityFilter));
    }

    private async Task LoadPrioritiesAsync()
    {
        workerPriorities = await InScopeAsync(s => s.GetRequiredService<PriorityRepository>().GetAllAsync(PriorityKind.Worker));
        jobPriorities = await InScopeAsync(s => s.GetRequiredService<PriorityRepository>().GetAllAsync(PriorityKind.Job));
        newMinWorkerPriority = PriorityNames.AnyWorker;
        newPriority = jobPriorities.First(p => p.IsDefault).Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _browserTz = await TimeZone.GetAsync();
            StateHasChanged();
        }
    }

    private async Task CreatePipeline()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newRepositoryId) || string.IsNullOrWhiteSpace(newScriptPath))
        {
            error = "Name, Repository, and Script Path are required.";
            return;
        }

        if (!Guid.TryParse(newRepositoryId, out var repoId))
        {
            error = "Please select a valid repository.";
            return;
        }

        creating = true;
        try
        {
            var submission = new PipelineSubmission
            {
                Name = newName.Trim(),
                RepositoryId = repoId,
                Ref = newDefaultRef.Trim(),
                ScriptPath = newScriptPath.Trim(),
                Schedule = ConvertScheduleToUtc(newSchedule),
                MinWorkerPriority = newMinWorkerPriority,
                Priority = newPriority,
                NotificationPolicy = newNotificationPolicy
            };

            await InScopeAsync(s => s.GetRequiredService<PipelineRepository>().CreateAsync(submission));

            newName = "";
            newRepositoryId = "";
            newDefaultRef = "main";
            newScriptPath = "";
            newSchedule = "";
            await LoadPrioritiesAsync();
            newNotificationPolicy = NotificationPolicy.All;

            pipelines = await InScopeAsync(s => s.GetRequiredService<PipelineRepository>().GetAllAsync(PriorityFilter, MinWorkerPriorityFilter));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            creating = false;
        }
    }

    private string? ConvertScheduleToUtc(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var trimmed = input.Trim();
        if (_browserTz == null) return trimmed;
        return CronTimezoneHelper.LocalToUtc(trimmed, _browserTz) ?? trimmed;
    }
}
